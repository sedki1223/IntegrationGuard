FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/integration-guard-api ./cmd/integration-guard-api

FROM alpine:3.22
RUN addgroup -S app && adduser -S app -G app
WORKDIR /app
COPY --from=build /out/integration-guard-api /app/integration-guard-api
USER app
EXPOSE 8080
ENTRYPOINT ["/app/integration-guard-api"]
